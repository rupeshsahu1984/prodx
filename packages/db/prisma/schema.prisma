// PRODX ERP — foundation schema (Phase 0)
//
// Encodes ADR 0003 (org hierarchy), 0004 (dual UoM), 0005 (valuation),
// 0006 (stock unit + genealogy), 0007 (fiscal periods), 0008 (numbering).
//
// Rules that hold for every model below:
//   - tenantId on every business table; RLS enforces it (ADR 0002, scripts/rls.sql).
//   - Money and quantity are Decimal, never Float.
//   - Every timestamp is timestamptz. Business dates are separate from system timestamps.
//   - Append-only tables have no updatedAt and are protected by a trigger.
//
// This is one file while the foundation is small. It splits into prisma/schema/
// once module schemas land — the split is mechanical, the decisions are not.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── organization (ADR 0003) ─────────────────────────────

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  legalEntities LegalEntity[]
  users         AppUser[]

  @@map("tenant")
}

model LegalEntity {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  code     String
  name     String

  /// GSTIN is per legal entity per state, not per tenant.
  taxRegistrationNo String?@map("tax_registration_no")
  baseCurrency      String  @default("INR") @db.Char(3) @map("base_currency")
  isActive          Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plants         Plant[]
  fiscalYears    FiscalYear[]
  glAccounts     GlAccount[]
  numberSeries   NumberSeries[]
  journals       JournalEntry[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("legal_entity")
}

model Plant {
  id            String  @id @default(uuid(7)) @db.Uuid
  tenantId      String  @db.Uuid @map("tenant_id")
  legalEntityId String  @db.Uuid @map("legal_entity_id")
  code          String
  name          String
  /// Rejecting negative stock keeps weighted-average valuation meaningful (ADR 0005).
  allowNegativeStock Boolean @default(false) @map("allow_negative_stock")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  legalEntity    LegalEntity          @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  warehouses     Warehouse[]
  valuations     ItemPlantValuation[]
  ledger         StockLedgerEntry[]
  purchaseOrders PurchaseOrder[]
  gateEvents     GateEvent[]
  goodsReceipts  GoodsReceipt[]
  departments    Department[]
  userAccess     UserPlantAccess[]

  @@unique([tenantId, code])
  @@index([tenantId, legalEntityId])
  @@map("plant")
}

model Warehouse {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @db.Uuid @map("tenant_id")
  plantId  String  @db.Uuid @map("plant_id")
  code     String
  name     String
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  plant     Plant             @relation(fields: [plantId], references: [id], onDelete: Restrict)
  locations StorageLocation[]

  @@unique([tenantId, plantId, code])
  @@index([tenantId, plantId])
  @@map("warehouse")
}

model StorageLocation {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @db.Uuid @map("tenant_id")
  warehouseId String  @db.Uuid @map("warehouse_id")
  code        String
  name        String
  /// Stock physically at a subcontractor is still ours (gap 20). Modelled as a
  /// location type rather than a separate table, so it flows through one ledger.
  isThirdParty Boolean @default(false) @map("is_third_party")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  balances  StockBalance[]
  ledger    StockLedgerEntry[]
  grnLines  GoodsReceiptLine[]

  @@unique([tenantId, warehouseId, code])
  @@index([tenantId, warehouseId])
  @@map("storage_location")
}

model AppUser {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @db.Uuid @map("tenant_id")
  email        String
  displayName  String@map("display_name")
  passwordHash String@map("password_hash")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  /// Tenant-wide administrator: every plant, every department. Still confined
  /// to this tenant — there is no cross-tenant user.
  isSuperAdmin Boolean @default(false) @map("is_super_admin")

  /// Brute-force protection. Cleared on a successful login.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  plantAccess   UserPlantAccess[]
  deptAccess    UserDepartmentAccess[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("app_user")
}

model Role {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  code     String
  name     String

  /// `domain:action` strings. `purchase_order:*` covers a domain, `*` everything.
  /// Wildcards expand only at segment boundaries.
  permissions String[]

  /// Roles that may not be held together, enforced when roles are assigned
  /// (gap 10). Whoever can create a supplier must not be able to approve its payment.
  conflictsWith String[] @map("conflicts_with")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("role")
}

model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String   @db.Uuid @map("user_id")
  roleId    String   @db.Uuid @map("role_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, roleId])
  @@index([tenantId, userId])
  @@map("user_role")
}

/// Refresh tokens are stored HASHED. A database read must not yield a usable
/// credential, and a token must be revocable — which a stateless JWT is not.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @db.Uuid @map("tenant_id")
  userId    String    @db.Uuid @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Set when this token was replaced. A reuse attempt after rotation means the
  /// token leaked, and the whole family is revoked.
  replacedById String? @map("replaced_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

// ───────────────────────────── item & unit of measure (ADR 0004) ─────────────────────────────

model Uom {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  code     String
  name     String
  /// LENGTH, MASS, AREA, VOLUME, COUNT — conversions are only valid within a dimension,
  /// except item-specific ones, which is exactly why those are a separate table.
  dimension String

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  itemsBase      Item[]              @relation("ItemBaseUom")
  itemsSecondary Item[]              @relation("ItemSecondaryUom")
  conversionFrom UomConversion[]     @relation("UomConversionFrom")
  conversionTo   UomConversion[]     @relation("UomConversionTo")
  itemConversion ItemUomConversion[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("uom")
}

/// Dimensionless conversions only (kg↔g, m↔cm). Anything that depends on the
/// material lives in ItemUomConversion.
model UomConversion {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @db.Uuid @map("tenant_id")
  fromUomId String  @db.Uuid @map("from_uom_id")
  toUomId   String  @db.Uuid @map("to_uom_id")
  factor    Decimal @db.Decimal(24, 12)

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  fromUom Uom @relation("UomConversionFrom", fields: [fromUomId], references: [id], onDelete: Restrict)
  toUom   Uom @relation("UomConversionTo", fields: [toUomId], references: [id], onDelete: Restrict)

  @@unique([tenantId, fromUomId, toUomId])
  @@map("uom_conversion")
}

model Item {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  code     String
  name     String

  /// All stock is stored in this unit (ADR 0004).
  baseUomId String @db.Uuid @map("base_uom_id")

  /// Dual-UoM items carry a second quantity on every movement and balance.
  /// A fabric roll is metres AND kilograms; both are recorded, neither is derived.
  isDualUom      Boolean @default(false) @map("is_dual_uom")
  secondaryUomId String? @db.Uuid @map("secondary_uom_id")

  granularity StockGranularity @default(LOT)

  /// Characteristics (style, colour, size, GSM, width) rather than flat SKUs (gap 19).
  characteristics Json @default("{}")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  baseUom      Uom                 @relation("ItemBaseUom", fields: [baseUomId], references: [id], onDelete: Restrict)
  secondaryUom Uom?                @relation("ItemSecondaryUom", fields: [secondaryUomId], references: [id], onDelete: Restrict)
  conversions  ItemUomConversion[]
  stockUnits   StockUnit[]
  valuations   ItemPlantValuation[]
  ledger       StockLedgerEntry[]
  poLines      PurchaseOrderLine[]
  grnLines     GoodsReceiptLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("item")
}

/// Item-specific conversion. Metres↔kilograms depends on GSM and width, so it
/// cannot live in a global table (ADR 0004).
model ItemUomConversion {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @db.Uuid @map("tenant_id")
  itemId   String  @db.Uuid @map("item_id")
  uomId    String  @db.Uuid @map("uom_id")
  /// Quantity of baseUom represented by one of uomId.
  factor   Decimal @db.Decimal(24, 12)

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  uom  Uom  @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@unique([tenantId, itemId, uomId])
  @@index([tenantId, itemId])
  @@map("item_uom_conversion")
}

// ───────────────────────────── inventory (ADR 0005, 0006) ─────────────────────────────

enum StockGranularity {
  BULK
  LOT
  SERIAL
}

/// The tracked physical entity. A textile roll is SERIAL; a board batch is LOT;
/// consumables are BULK. BULK items still get a row so the ledger has one uniform
/// shape — a nullable stock unit would put a branch in every inventory query forever.
model StockUnit {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  itemId   String @db.Uuid @map("item_id")
  /// Lot code, roll number or batch number as the plant knows it.
  reference String

  granularity StockGranularity

  /// Attributes allocation may constrain on. Shade band is what makes dye-lot
  /// continuity possible (gap 18) — generic ERPs cannot express this.
  shadeBand String?@map("shade_band")
  grade     String?

  /// Measured, not computed. The weighbridge and the roll scale are the source.
  secondaryQuantity Decimal? @db.Decimal(18, 6) @map("secondary_quantity")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  item      Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  balances  StockBalance[]
  ledger    StockLedgerEntry[]
  parents   StockUnitLink[]    @relation("LinkChild")
  children  StockUnitLink[]    @relation("LinkParent")
  grnLines  GoodsReceiptLine[]

  @@unique([tenantId, itemId, reference])
  @@index([tenantId, itemId])
  @@index([tenantId, shadeBand])
  @@map("stock_unit")
}

/// Genealogy is a DAG, not a tree (ADR 0006). A beam splits into many rolls;
/// several rolls merge into one shipment. A parentId column cannot express a merge,
/// and a recall must traverse both directions.
///
/// Append-only: a correction adds a reversing transformation, it never deletes an edge.
model StockUnitLink {
  id                  String  @id @default(uuid(7)) @db.Uuid
  tenantId            String  @db.Uuid @map("tenant_id")
  parentStockUnitId   String  @db.Uuid @map("parent_stock_unit_id")
  childStockUnitId    String  @db.Uuid @map("child_stock_unit_id")
  /// The document that caused the link — work order, grading, packing list — so the
  /// trace explains itself rather than being a bare edge.
  transformationType  String@map("transformation_type")
  transformationId    String  @db.Uuid @map("transformation_id")
  quantityContributed Decimal @db.Decimal(18, 6) @map("quantity_contributed")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  parent StockUnit @relation("LinkParent", fields: [parentStockUnitId], references: [id], onDelete: Restrict)
  child  StockUnit @relation("LinkChild", fields: [childStockUnitId], references: [id], onDelete: Restrict)

  @@unique([tenantId, parentStockUnitId, childStockUnitId, transformationId])
  @@index([tenantId, parentStockUnitId])
  @@index([tenantId, childStockUnitId])
  @@map("stock_unit_link")
}

enum LedgerDirection {
  IN
  OUT
}

/// Append-only. Balances are projections of this table and are never the source of truth.
model StockLedgerEntry {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  plantId  String @db.Uuid @map("plant_id")

  itemId            String @db.Uuid @map("item_id")
  stockUnitId       String @db.Uuid @map("stock_unit_id")
  storageLocationId String @db.Uuid @map("storage_location_id")

  direction LedgerDirection

  /// Always in the item's base UoM (ADR 0004).
  quantity Decimal @db.Decimal(18, 6)
  /// Dual-UoM items carry the second quantity here. Captured, not derived.
  secondaryQuantity Decimal? @db.Decimal(18, 6) @map("secondary_quantity")

  /// Moving weighted average at the time of the movement (ADR 0005).
  unitCost   Decimal @db.Decimal(18, 6) @map("unit_cost")
  totalValue Decimal @db.Decimal(18, 2) @map("total_value")

  /// The business date the movement belongs to. Distinct from createdAt, and the
  /// value the fiscal period is resolved from (ADR 0007).
  postingDate DateTime @db.Date @map("posting_date")

  sourceType String@map("source_type")
  sourceId   String   @db.Uuid @map("source_id")
  createdAt  DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  plant           Plant           @relation(fields: [plantId], references: [id], onDelete: Restrict)
  item            Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  stockUnit       StockUnit       @relation(fields: [stockUnitId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)

  @@index([tenantId, plantId, itemId, postingDate])
  @@index([tenantId, stockUnitId])
  @@index([tenantId, sourceType, sourceId])
  @@map("stock_ledger_entry")
}

/// Projection of the ledger, maintained in the same transaction as the ledger insert.
model StockBalance {
  id                String @id @default(uuid(7)) @db.Uuid
  tenantId          String @db.Uuid @map("tenant_id")
  stockUnitId       String @db.Uuid @map("stock_unit_id")
  storageLocationId String @db.Uuid @map("storage_location_id")

  quantity          Decimal  @db.Decimal(18, 6)
  secondaryQuantity Decimal? @db.Decimal(18, 6) @map("secondary_quantity")

  /// Optimistic locking — two pickers must not both allocate the last roll.
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  stockUnit       StockUnit       @relation(fields: [stockUnitId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, stockUnitId, storageLocationId])
  @@index([tenantId, storageLocationId])
  @@map("stock_balance")
}

/// Moving weighted average per item and plant (ADR 0005). Updated inside the same
/// transaction as the ledger insert, never recomputed from scratch at read time.
model ItemPlantValuation {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  itemId   String @db.Uuid @map("item_id")
  plantId  String @db.Uuid @map("plant_id")

  quantityOnHand Decimal @db.Decimal(18, 6) @map("quantity_on_hand")
  totalValue     Decimal @db.Decimal(18, 2) @map("total_value")
  /// Derived: totalValue / quantityOnHand. Stored so the ledger can record the
  /// cost that actually applied at the moment of the movement.
  unitCost       Decimal @db.Decimal(18, 6) @map("unit_cost")

  version   Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  item  Item  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  plant Plant @relation(fields: [plantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, itemId, plantId])
  @@map("item_plant_valuation")
}

// ───────────────────────────── fiscal calendar (ADR 0007) ─────────────────────────────

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

model FiscalYear {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @db.Uuid @map("tenant_id")
  legalEntityId String   @db.Uuid @map("legal_entity_id")
  /// Indian fiscal year label, e.g. "2026-27".
  code          String
  startDate     DateTime @db.Date @map("start_date")
  endDate       DateTime @db.Date @map("end_date")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  legalEntity LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  periods     FiscalPeriod[]

  @@unique([tenantId, legalEntityId, code])
  @@map("fiscal_year")
}

model FiscalPeriod {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @db.Uuid @map("tenant_id")
  fiscalYearId String       @db.Uuid @map("fiscal_year_id")
  sequence     Int
  startDate    DateTime     @db.Date @map("start_date")
  endDate      DateTime     @db.Date @map("end_date")
  status       PeriodStatus @default(OPEN)

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([tenantId, fiscalYearId, sequence])
  @@index([tenantId, startDate, endDate])
  @@map("fiscal_period")
}

// ───────────────────────────── general ledger ─────────────────────────────

model GlAccount {
  id            String  @id @default(uuid(7)) @db.Uuid
  tenantId      String  @db.Uuid @map("tenant_id")
  legalEntityId String  @db.Uuid @map("legal_entity_id")
  code          String
  name          String
  /// ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  accountType   String@map("account_type")
  isPostable    Boolean @default(true) @map("is_postable")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  legalEntity LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  lines       JournalLine[]

  @@unique([tenantId, legalEntityId, code])
  @@map("gl_account")
}

/// Append-only. A posted entry is never edited — it is reversed and reposted.
model JournalEntry {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @db.Uuid @map("tenant_id")
  legalEntityId String @db.Uuid @map("legal_entity_id")

  documentNo  String@map("document_no")
  postingDate DateTime @db.Date @map("posting_date")
  narration   String?

  sourceType String@map("source_type")
  sourceId   String @db.Uuid @map("source_id")

  /// Set when this entry reverses another. Never both edited and reversed.
  reversesJournalEntryId String? @db.Uuid @map("reverses_journal_entry_id")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  legalEntity LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  lines       JournalLine[]

  @@unique([tenantId, legalEntityId, documentNo])
  @@index([tenantId, legalEntityId, postingDate])
  @@index([tenantId, sourceType, sourceId])
  @@map("journal_entry")
}

model JournalLine {
  id             String  @id @default(uuid(7)) @db.Uuid
  tenantId       String  @db.Uuid @map("tenant_id")
  journalEntryId String  @db.Uuid @map("journal_entry_id")
  glAccountId    String  @db.Uuid @map("gl_account_id")
  lineNo         Int@map("line_no")
  debit          Decimal @default(0) @db.Decimal(18, 2)
  credit         Decimal @default(0) @db.Decimal(18, 2)
  /// Cost centre, plant, project — reporting dimensions kept out of the account code.
  dimensions     Json    @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  glAccount    GlAccount    @relation(fields: [glAccountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, journalEntryId, lineNo])
  @@index([tenantId, glAccountId])
  @@map("journal_line")
}

// ───────────────────────────── platform services ─────────────────────────────

/// Gapless numbering (ADR 0008). Incremented with UPDATE … RETURNING inside the
/// document's own transaction, so a rollback returns the number.
model NumberSeries {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @db.Uuid @map("tenant_id")
  legalEntityId String @db.Uuid @map("legal_entity_id")
  seriesCode    String@map("series_code")
  fiscalYear    String@map("fiscal_year")
  /// Placeholders: {FY}, {####}. Resolved after the number is allocated.
  format        String
  nextValue     Int    @default(1) @map("next_value")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, legalEntityId, seriesCode, fiscalYear])
  @@map("number_series")
}

/// Append-only: who changed what, when, why and from which source.
model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  actorId    String?  @db.Uuid @map("actor_id")
  entityType String@map("entity_type")
  entityId   String   @db.Uuid @map("entity_id")
  action     String
  /// Only the changed fields, before and after. Never the whole row — payroll and
  /// bank details must not be duplicated into the audit log.
  changes    Json     @default("{}")
  reason     String?
  source     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@map("audit_event")
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

/// Transactional outbox (gap 9). External calls never happen inside a database
/// transaction; the intent is committed here and a worker delivers it.
model OutboxMessage {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @db.Uuid @map("tenant_id")
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?@map("last_error")
  availableAt DateTime     @default(now()) @db.Timestamptz(6) @map("available_at")
  createdAt   DateTime     @default(now()) @db.Timestamptz(6) @map("created_at")
  sentAt      DateTime?    @db.Timestamptz(6) @map("sent_at")

  @@index([status, availableAt])
  @@index([tenantId, topic, createdAt])
  @@map("outbox_message")
}

/// Gate scanners double-tap and weighbridges resend over flaky serial links (gap 8).
/// The stored response is replayed rather than the operation being repeated.
model IdempotencyKey {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  source      String
  externalRef String@map("external_ref")
  requestHash String@map("request_hash")
  response    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, source, externalRef])
  @@index([tenantId, createdAt])
  @@map("idempotency_key")
}

// ───────────────────────────── procure to pay ─────────────────────────────

enum PartyType {
  SUPPLIER
  CUSTOMER
  BOTH
}

model Party {
  id       String    @id @default(uuid(7)) @db.Uuid
  tenantId String    @db.Uuid @map("tenant_id")
  code     String
  name     String
  type     PartyType
  taxRegistrationNo String? @map("tax_registration_no")
  isActive Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("party")
}

enum PurchaseOrderState {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RELEASED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @db.Uuid @map("tenant_id")
  legalEntityId String @db.Uuid @map("legal_entity_id")
  plantId       String @db.Uuid @map("plant_id")

  documentNo String             @map("document_no")
  supplierId String             @db.Uuid @map("supplier_id")
  state      PurchaseOrderState @default(DRAFT)

  orderDate   DateTime @map("order_date") @db.Date
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(18, 2)
  currency    String   @default("INR") @db.Char(3)

  /// Who moved it into PENDING_APPROVAL. Maker-checker needs this, and it must
  /// be the submitter, not the creator — they can differ.
  submittedById String?   @db.Uuid @map("submitted_by_id")
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(6)

  /// Optimistic locking. Two buyers editing the same order must not silently
  /// overwrite each other.
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  legalEntity   LegalEntity         @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  plant         Plant               @relation(fields: [plantId], references: [id], onDelete: Restrict)
  supplier      Party               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  gateEvents    GateEvent[]

  @@unique([tenantId, legalEntityId, documentNo])
  @@index([tenantId, plantId, state])
  @@index([tenantId, supplierId])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id              String @id @default(uuid(7)) @db.Uuid
  tenantId        String @db.Uuid @map("tenant_id")
  purchaseOrderId String @db.Uuid @map("purchase_order_id")
  lineNo          Int    @map("line_no")

  itemId   String  @db.Uuid @map("item_id")
  /// Ordered quantity in the item's base UoM.
  quantity Decimal @db.Decimal(18, 6)
  /// Dual-UoM items: the expected second quantity. Captured at receipt, not derived.
  secondaryQuantity Decimal? @map("secondary_quantity") @db.Decimal(18, 6)

  rate   Decimal @db.Decimal(18, 6)
  amount Decimal @db.Decimal(18, 2)

  /// Maintained as receipts post, so over-receipt can be refused.
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(18, 6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  item          Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  grnLines      GoodsReceiptLine[]

  @@unique([tenantId, purchaseOrderId, lineNo])
  @@index([tenantId, itemId])
  @@map("purchase_order_line")
}

/// Approval thresholds (gap 11). Bands are [minAmount, maxAmount) so they cannot overlap.
model ApprovalRule {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @db.Uuid @map("tenant_id")
  documentType String  @map("document_type")
  minAmount    Decimal @map("min_amount") @db.Decimal(18, 2)
  maxAmount    Decimal? @map("max_amount") @db.Decimal(18, 2)
  plantId      String? @db.Uuid @map("plant_id")
  category     String?
  permission   String
  sequence     Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  approvals ApprovalRecord[]

  @@index([tenantId, documentType])
  @@map("approval_rule")
}

/// Append-only: an approval is a fact about who decided what, and when.
model ApprovalRecord {
  id           String @id @default(uuid(7)) @db.Uuid
  tenantId     String @db.Uuid @map("tenant_id")
  documentType String @map("document_type")
  documentId   String @db.Uuid @map("document_id")
  ruleId       String @db.Uuid @map("rule_id")
  approvedById String @db.Uuid @map("approved_by_id")
  comment      String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rule ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, documentType, documentId, ruleId])
  @@index([tenantId, documentType, documentId])
  @@map("approval_record")
}

// ───────────────────────────── gate & weighbridge ─────────────────────────────

enum GateDirection {
  IN
  OUT
}

/// Append-only: a gate event is an immutable record of something that physically
/// happened. Corrections are a new event, never an edit.
model GateEvent {
  id       String        @id @default(uuid(7)) @db.Uuid
  tenantId String        @db.Uuid @map("tenant_id")
  plantId  String        @db.Uuid @map("plant_id")
  direction GateDirection

  vehicleNo  String  @map("vehicle_no")
  driverName String? @map("driver_name")
  /// The business document the vehicle is here for, when known at the gate.
  purchaseOrderId String? @db.Uuid @map("purchase_order_id")

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  /// The scanner or terminal's own reference. Unique per source so a double-tap
  /// or a retry cannot create a second event (gap 8).
  deviceSource String @map("device_source")
  deviceRef    String @map("device_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plant         Plant               @relation(fields: [plantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  weighbridge   WeighbridgeTicket[]
  goodsReceipts GoodsReceipt[]

  @@unique([tenantId, deviceSource, deviceRef])
  @@index([tenantId, plantId, occurredAt])
  @@index([tenantId, vehicleNo])
  @@map("gate_event")
}

/// Append-only. Weighbridges resend over flaky serial links, so the device
/// reference is the idempotency key.
model WeighbridgeTicket {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @db.Uuid @map("tenant_id")
  gateEventId String @db.Uuid @map("gate_event_id")

  grossWeight Decimal @map("gross_weight") @db.Decimal(18, 3)
  tareWeight  Decimal @map("tare_weight") @db.Decimal(18, 3)
  /// Stored, not computed on read: the scale is the source of truth and a later
  /// change to gross or tare must not silently restate a historical net.
  netWeight   Decimal @map("net_weight") @db.Decimal(18, 3)
  weighedAt   DateTime @map("weighed_at") @db.Timestamptz(6)

  deviceSource String @map("device_source")
  deviceRef    String @map("device_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  gateEvent GateEvent @relation(fields: [gateEventId], references: [id], onDelete: Restrict)

  @@unique([tenantId, deviceSource, deviceRef])
  @@index([tenantId, gateEventId])
  @@map("weighbridge_ticket")
}

// ───────────────────────────── goods receipt ─────────────────────────────

enum GoodsReceiptState {
  DRAFT
  POSTED
  REVERSED
}

model GoodsReceipt {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @db.Uuid @map("tenant_id")
  legalEntityId String @db.Uuid @map("legal_entity_id")
  plantId       String @db.Uuid @map("plant_id")

  documentNo      String            @map("document_no")
  purchaseOrderId String            @db.Uuid @map("purchase_order_id")
  supplierId      String            @db.Uuid @map("supplier_id")
  state           GoodsReceiptState @default(DRAFT)

  /// The business date the movement belongs to. The fiscal period is resolved
  /// from this, never from createdAt (ADR 0007).
  postingDate DateTime @map("posting_date") @db.Date

  gateEventId String? @db.Uuid @map("gate_event_id")

  /// A posted receipt is reversed, never edited (CLAUDE.md invariant 2).
  reversedById   String? @db.Uuid @map("reversed_by_id")
  reversesGrnId  String? @db.Uuid @map("reverses_grn_id")

  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  legalEntity   LegalEntity        @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  plant         Plant              @relation(fields: [plantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Party              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  gateEvent     GateEvent?         @relation(fields: [gateEventId], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]

  @@unique([tenantId, legalEntityId, documentNo])
  @@index([tenantId, plantId, state, postingDate])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id             String @id @default(uuid(7)) @db.Uuid
  tenantId       String @db.Uuid @map("tenant_id")
  goodsReceiptId String @db.Uuid @map("goods_receipt_id")
  lineNo         Int    @map("line_no")

  purchaseOrderLineId String @db.Uuid @map("purchase_order_line_id")
  itemId              String @db.Uuid @map("item_id")
  stockUnitId         String @db.Uuid @map("stock_unit_id")
  storageLocationId   String @db.Uuid @map("storage_location_id")

  quantity Decimal @db.Decimal(18, 6)
  /// Measured at the weighbridge or the scale, never derived from the first
  /// quantity (ADR 0004).
  secondaryQuantity Decimal? @map("secondary_quantity") @db.Decimal(18, 6)

  unitCost Decimal @map("unit_cost") @db.Decimal(18, 6)
  amount   Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  item              Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  stockUnit         StockUnit         @relation(fields: [stockUnitId], references: [id], onDelete: Restrict)
  storageLocation   StorageLocation   @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, goodsReceiptId, lineNo])
  @@index([tenantId, purchaseOrderLineId])
  @@map("goods_receipt_line")
}

// ───────────────────────────── access scope ─────────────────────────────
//
// Two dimensions decide what a user may do:
//   permissions — WHICH ACTIONS (roles, checked by the guard)
//   scope       — WHICH DATA   (plants and departments, enforced by RLS)
//
// They are deliberately separate. A plant head and a group buyer may hold the
// same permissions and still see completely different data.

model Department {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @db.Uuid @map("tenant_id")
  plantId  String  @db.Uuid @map("plant_id")
  code     String
  name     String
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant      Plant                  @relation(fields: [plantId], references: [id], onDelete: Restrict)
  userAccess UserDepartmentAccess[]

  @@unique([tenantId, plantId, code])
  @@index([tenantId, plantId])
  @@map("department")
}

/// Which factories a user may see. A superadmin needs no rows here.
model UserPlantAccess {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String   @db.Uuid @map("user_id")
  plantId   String   @db.Uuid @map("plant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  plant Plant   @relation(fields: [plantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, plantId])
  @@index([tenantId, userId])
  @@map("user_plant_access")
}

/// Which departments within those factories. Empty means every department of
/// the plants the user can see — a plant head is not restricted by department.
model UserDepartmentAccess {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid @map("tenant_id")
  userId       String   @db.Uuid @map("user_id")
  departmentId String   @db.Uuid @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       AppUser    @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, departmentId])
  @@index([tenantId, userId])
  @@map("user_department_access")
}
