# Copy to .env and replace every REPLACE_ME. Nothing here is a usable default.

# Application connects as a NON-OWNER role so RLS cannot be bypassed (ADR 0002).
DATABASE_URL="postgresql://prodx_app:REPLACE_ME@localhost:5432/prodx?schema=public"

# Migrations run as the owner. Never point the running application at this.
DATABASE_MIGRATION_URL="postgresql://prodx_owner:REPLACE_ME@localhost:5432/prodx?schema=public"

# Password for the prodx_app role, passed to scripts/create-app-role.sql.
# Must match the one in DATABASE_URL.
PRODX_APP_PASSWORD="REPLACE_ME"

# Phase 0 only. Enables the header-based tenant stub, which trusts the caller
# and is therefore refused in production. Remove this once JWT auth lands.
PRODX_ALLOW_HEADER_TENANT="1"

REDIS_URL="redis://localhost:6379"

S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="prodx-attachments"
S3_ACCESS_KEY="REPLACE_ME"
S3_SECRET_KEY="REPLACE_ME"

JWT_SECRET="REPLACE_ME"
