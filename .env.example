# Application connects as a NON-OWNER role so RLS cannot be bypassed (ADR 0002).
DATABASE_URL="postgresql://prodx_app:change-me@localhost:5432/prodx?schema=public"

# Migrations run as the owner. Never use this for the running application.
DATABASE_MIGRATION_URL="postgresql://prodx_owner:change-me@localhost:5432/prodx?schema=public"

REDIS_URL="redis://localhost:6379"

S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="prodx-attachments"
S3_ACCESS_KEY="change-me"
S3_SECRET_KEY="change-me"

JWT_SECRET="change-me-in-every-environment"
